{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "v8.0.0",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "aws-access-token",
              "shortDescription": {
                "text": "Identified a pattern that may indicate AWS credentials, risking unauthorized cloud resource access and data breaches on AWS platforms."
              }
            },
            {
              "id": "github-pat",
              "shortDescription": {
                "text": "Uncovered a GitHub Personal Access Token, potentially leading to unauthorized repository access and sensitive content exposure."
              }
            }
          ]
        }
      },
      "results": [
        {
          "message": {
            "text": "aws-access-token has detected secret for file config.env."
          },
          "ruleId": "aws-access-token",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config.env"
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 20,
                  "endLine": 2,
                  "endColumn": 39,
                  "snippet": {
                    "text": "REDACTED"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "commitSha": "",
            "email": "",
            "author": "",
            "date": "",
            "commitMessage": ""
          },
          "properties": {
            "tags": []
          }
        },
        {
          "message": {
            "text": "github-pat has detected secret for file deploy.sh."
          },
          "ruleId": "github-pat",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "deploy.sh"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 22,
                  "endLine": 3,
                  "endColumn": 61,
                  "snippet": {
                    "text": "REDACTED"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "commitSha": "",
            "email": "",
            "author": "",
            "date": "",
            "commitMessage": ""
          },
          "properties": {
            "tags": []
          }
        }
      ]
    }
  ]
}
